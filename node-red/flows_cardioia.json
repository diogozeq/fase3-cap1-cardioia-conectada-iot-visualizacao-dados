    "name": "Sinais vitais",
    "tab": "ui_tab_cardioia",
    "order": 1,
    "disp": true,
    "width": "12",
    "collapse": false
  },
  {
    "id": "ui_group_alerts",
    "type": "ui_group",
    "name": "Alertas",
    "tab": "ui_tab_cardioia",
    "order": 2,
    "disp": true,
    "width": "12",
    "collapse": false
  },
  {
    "id": "mqtt_in_vitals",
    "type": "mqtt in",
    "z": "tab_cardioia_fase3",
    "name": "MQTT vitals",
    "topic": "cardioia/patients/+/vitals",
    "qos": "0",
    "datatype": "json",
    "broker": "mqtt_hivemq_cardioia",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 130,
    "y": 120,
    "wires": [["fn_normalize_payload"]]
  },
  {
    "id": "fn_normalize_payload",
    "type": "function",
    "z": "tab_cardioia_fase3",
    "name": "normalizar leitura",
    "func": "const p = msg.payload || {};\nmsg.cardioia = {\n    patient_id: p.patient_id || 'sem-paciente',\n    bpm: Number(p.bpm || 0),\n    temperature_c: Number(p.temperature_c || 0),\n    humidity_pct: Number(p.humidity_pct || 0),\n    movement: Boolean(p.movement),\n    risk_level: p.risk_level || 'normal',\n    alert_reason: p.alert_reason || 'sem alerta',\n    offline_buffer_count: Number(p.offline_buffer_count || 0),\n    timestamp_ms: p.timestamp_ms || Date.now()\n};\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 340,
    "y": 120,
    "wires": [["fn_split_dashboard"]]
  },
  {
    "id": "fn_split_dashboard",
    "type": "function",
    "z": "tab_cardioia_fase3",
    "name": "separar metricas",
    "func": "const c = msg.cardioia;\nreturn [\n  { payload: c.bpm, topic: 'BPM' },\n  { payload: c.temperature_c, topic: 'Temperatura C' },\n  { payload: c.humidity_pct, topic: 'Umidade %' },\n  { payload: c.risk_level === 'normal' ? 'NORMAL - ' + c.alert_reason : 'ALERTA ' + c.risk_level.toUpperCase() + ' - ' + c.alert_reason },\n  { payload: c.offline_buffer_count, topic: 'Buffer offline' }\n];",
    "outputs": 5,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 560,
    "y": 120,
    "wires": [
      ["chart_bpm"],
      ["gauge_temp"],
      ["gauge_humidity"],
      ["text_alert"],
      ["gauge_buffer"]
    ]
  },
  {
    "id": "chart_bpm",
    "type": "ui_chart",
    "z": "tab_cardioia_fase3",
