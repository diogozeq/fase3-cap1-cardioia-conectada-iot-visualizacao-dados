    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true,
    "birthTopic": "cardioia/system/status",
    "birthQos": "0",
    "birthPayload": "{\"node_red\":\"online\"}",
    "closeTopic": "cardioia/system/status",
    "closePayload": "{\"node_red\":\"offline\"}",
    "willTopic": "cardioia/system/status",
    "willQos": "0",
    "willPayload": "{\"node_red\":\"lost\"}"
  },
  {
    "id": "tls_hivemq_cardioia",
    "type": "tls-config",
    "name": "TLS HiveMQ",
    "cert": "",
